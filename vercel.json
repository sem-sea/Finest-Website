{
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "functions": {
    "api/*.js": { "includeFiles": "content-seed/**", "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/cms?route=:route*" },
    { "source": "/", "destination": "/api/site?path=" },
    { "source": "/:path*", "destination": "/api/site?path=:path*" }
  ]
}
